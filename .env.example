# Kazanime — environment variable (SEMUA opsional). Salin ke .env untuk lokal:
#   node --env-file=.env server/index.js
# Di Vercel: Project → Settings → Environment Variables.

# --- Identitas bot (tampil di User-Agent & /api/bot) ---
# BOT_CONTACT=email@contoh.com
# PUBLIC_SITE_URL=https://kazanime.vercel.app
# SCRAPER_USER_AGENT=

# --- Sumber scraping (urutan = prioritas) ---
# SCRAPER_SOURCES=animexin,samehadaku,anoboy,sakunime,anichin,otakudesu,hianime,kuramanime
# AnimeIndo hanya opt-in; aktifkan hanya bila robots.txt mengizinkan:
# SCRAPER_SOURCES=animexin,samehadaku,anoboy,sakunime,anichin,otakudesu,hianime,kuramanime,animeindo
# ANIMEINDO_BASE_URL=https://animeindo.cloud
# ANIMEINDO_RENDER_JAVASCRIPT=0
# Anoboy/Sakunime aktif default sebagai sumber Sub Indo; adapter tetap fail-closed sampai robots.txt terbaca & mengizinkan.
# Hapus dari SCRAPER_SOURCES bila ingin mematikannya.
# ANOBOY_BASE_URL=https://anoboy.be
# SAKUNIME_BASE_URL=https://sakunime.com
# ANIMEXIN_BASE_URL=https://animexin.dev
# SAMEHADAKU_BASE_URL=https://v2.samehadaku.how
# AnimeOnsen tetap opt-in. Isi hanya kredensial resmi yang Anda berwenang gunakan;
# jangan masukkan secret ke repo/chat. Sumber baru auto-enabled hanya bila ID, secret,
# dan allowlist CDN media diisi. Semua host tetap wajib lolos robots.txt eksplisit.
# ANIMEONSEN_CLIENT_ID=
# ANIMEONSEN_CLIENT_SECRET=
# ANIMEONSEN_MEDIA_HOSTS=   # hostname CDN persis (comma-separated), dikonfirmasi dari respons API/izin resmi; tanpa suffix wildcard/default
# SAMEHADAKU_RENDER_JAVASCRIPT=0          # aktifkan hanya setelah kebutuhan JS terverifikasi
# SAMEHADAKU_COOKIES=1
# ANICHIN_BASE_URL=https://anichin.moe
# OTAKUDESU_BASE_URL=https://otakudesu.blog
# OTAKUDESU_RENDER_JAVASCRIPT=0
# OTAKUDESU_COOKIES=1
# HIANIME_BASE_URL=https://hianime.ro
# Kuramanime v9 dicoba sebagai sumber Sub Indo; robots.txt wajib terbaca dan mengizinkan sebelum halaman diakses.
# Pilih satu base secara manual per deployment; tidak ada auto-failover antar-domain.
# Default tetap v20. Alternatif v9 berikut diberikan pengguna dan belum diverifikasi live:
# KURAMANIME_BASE_URL=https://v9.kuramanime.blog
# KURAMANIME_BASE_URL=https://v9.kuramanime.work # default
# KURAMANIME_BASE_URL=https://v20.kuramanime.ing
# KURAMANIME_RENDER_JAVASCRIPT=0
# KURAMANIME_COOKIES=1
# Kusonime hanya untuk pencarian paket download; judul dicocokkan secara ketat dari kandidat Romaji.
# Set 0 untuk mematikan. Base default https://kusonime.com, tanpa auto-failover; robots.txt wajib mengizinkan.
# KUSONIME_DOWNLOADS_ENABLED=1
# KUSONIME_BASE_URL=https://kusonime.com

# --- Penyedia server stream (22 Okt 2026) ---
# STREAM_PROVIDERS=reanime,anizone
# Secret HMAC URL proxy HLS/subtitle — ISI di produksi (≥ 16 karakter acak, mis. hasil `openssl rand -hex 32`)
# STREAM_SECRET=
# STREAM_PROXY_RATE_LIMIT_PER_MIN=900
# STREAM_PROXY_TIMEOUT_MS=20000
# ANIZONE_BASE_URL=https://anizone.to
# ANIZONE_MEDIA_HOSTS=xin-cdn.xyz
# REANIME_BASE_URL=https://reanime.to
# REANIME_EMBED_HOSTS=flixcloud.cc

# --- Subtitle Indonesia (AI) — Tahap F (22 Okt 2026) ---
# Isi HANYA di Vercel (Settings → Environment Variables) atau .env lokal yang tidak di-commit.
# JANGAN pernah menulis key asli di file ini / di repo (repo publik) / di chat. Kosong = fitur mati.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite      # "none" = tanpa model cadangan
# AI_SUBTITLES=1                                   # 0 = matikan walau key ada
# AI_SUBTITLE_PART_LINES=220
# AI_SUBTITLE_PART_CHARS=9000
# AI_SUBTITLE_TIMEOUT_MS=40000
# AI_SUBTITLE_RATE_LIMIT_PER_MIN=20

# --- Proxy scraper (opsional; hanya egress yang diizinkan operator) ---
# Daftar dipisah titik koma: HTTP/HTTPS dan SOCKS4a/5/5h (SOCKS4 biasa tidak didukung). User/password gunakan URL-encoding.
# Jangan gunakan rotasi untuk menghindari 403/429/CAPTCHA: pembatasan menghentikan sumber dan membuka cooldown.
# SCRAPER_PROXY_URLS=http://user:pass@proxy1.example:8080;socks5h://user:pass@proxy2.example:1080
# SCRAPER_PROXY_ROTATION=round-robin       # round-robin | sticky | disabled
# SCRAPER_PROXY_HEALTH_CHECK=1             # TCP check; bukan tes akses ke situs sumber
# SCRAPER_PROXY_CONNECT_TIMEOUT_MS=2000
# SCRAPER_PROXY_HEALTH_TTL_MS=30000
# SCRAPER_PROXY_COOLDOWN_MS=30000
# Tanpa SCRAPER_PROXY_URLS, satu HTTPS_PROXY/HTTP_PROXY/ALL_PROXY (bila ada) juga dikenali.
# Hindari sekaligus mengatur NODE_USE_ENV_PROXY agar tidak ada dua lapisan routing proxy.

# --- Gerbang robots.txt (23 Okt 2026) ---
# off      : robots.txt tidak diminta sama sekali (DEFAULT proyek ini)
# warn     : robots.txt dibaca untuk diagnosis, tetapi tidak memblokir request
# enforce  : taati robots.txt sepenuhnya (perilaku lama)
# Apa pun modenya, 403/429/CAPTCHA tetap berhenti tanpa retry/rotasi/solver.
# SCRAPER_ROBOTS_MODE=off

# --- Perilaku scraper ---
# SCRAPER_TIMEOUT_MS=6000
# SCRAPER_RETRIES=1                         # hanya error jaringan/5xx; 403/429/challenge tidak diulang
# SCRAPER_MIN_INTERVAL_MS=1000
# SCRAPER_MAX_CONCURRENCY_PER_HOST=2
# SCRAPER_COOKIES_ENABLED=1
# Cookie tersimpan di memori bila key kosong. Persistent jar dienkripsi AES-256-GCM bila key >= 32 karakter.
# Set key hanya di .env lokal yang di-ignore / secret manager; jangan di-commit atau log.
# SCRAPER_COOKIE_STORE_KEY=
# SCRAPER_COOKIE_STORE_PATH=.scraper-data/cookies.enc
# --- Playwright (optional; tidak dipakai untuk challenge/captcha) ---
# npm install mengikutkan playwright-core opsional; install Chromium terpisah: npx playwright-core install chromium
# Aktifkan JS rendering hanya untuk sumber yang kebutuhan JavaScript-nya sudah diverifikasi.
# SCRAPER_BROWSER_ENABLED=1
# SCRAPER_BROWSER_SETTLE_MS=350
# PLAYWRIGHT_EXECUTABLE_PATH=
# SCRAPER_BROWSER_LOCALE=id-ID
# SCRAPER_BROWSER_TIMEZONE=Asia/Jakarta
# SAMEHADAKU_RENDER_JAVASCRIPT=0
# OTAKUDESU_RENDER_JAVASCRIPT=0
# KURAMANIME_RENDER_JAVASCRIPT=0

# --- Cache (detik) & CDN ---
# CACHE_MAX_ENTRIES=500
# CACHE_LATEST_SEC=600
# CACHE_SEARCH_SEC=900
# CACHE_DETAIL_SEC=900
# CACHE_EPISODE_SEC=900
# CACHE_SCHEDULE_SEC=3600
# CDN_S_MAXAGE=600
# CDN_STALE_WHILE_REVALIDATE=1800

# --- API ---
# REQUEST_BUDGET_MS=10000
# RATE_LIMIT_PER_MIN=60
# CORS_ORIGINS=http://localhost:5500
# LOG_REQUESTS=1

# --- Fallback metadata (Jikan dihapus 22 Okt 2026) ---
# METADATA_FALLBACK=1
# METADATA_ORDER=kitsu,anilist
# METADATA_TIMEOUT_MS=6000
# METADATA_ENRICH_IMAGES=1
# METADATA_POSTER_SOURCES=kitsu,bangumi,mangabaka

# --- Server lokal ---
# PORT=3000
# HOST=0.0.0.0
