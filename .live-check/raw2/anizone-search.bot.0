u0022is_unsafe\u0022:false,\u0022start_year\u0022:2020,\u0022episode_count\u0022:11,\u0022tags\u0022:[{\u0022slug\u0022:\u00222ch5lzak\u0022,\u0022url\u0022:\u0022http:\\\/\\\/anizone.to\\\/tag\\\/2ch5lzak\u0022,\u0022name\u0022:\u0022Novel\u0022},{\u0022slug\u0022:\u00228euvyf6d\u0022,\u0022url\u0022:\u0022http:\\\/\\\/anizone.to\\\/tag\\\/8euvyf6d\u0022,\u0022name\u0022:\u0022Isekai\u0022},{\u0022slug\u0022:\u0022xerwtqaz\u0022,\u0022url\u0022:\u0022http:\\\/\\\/anizone.to\\\/tag\\\/xerwtqaz\u0022,\u0022name\u0022:\u0022Science Fiction\u0022},{\u0022slug\u0022:\u0022tzgxn5ic\u0022,\u0022url\u0022:\u0022http:\\\/\\\/anizone.to\\\/tag\\\/tzgxn5ic\u0022,\u0022name\u0022:\u0022Seinen\u0022},{\u0022slug\u0022:\u0022yxpb0efa\u0022,\u0022url\u0022:\u0022http:\\\/\\\/anizone.to\\\/tag\\\/yxpb0efa\u0022,\u0022name\u0022:\u0022Virtual World\u0022},{\u0022slug\u0022:\u0022acttdztd\u0022,\u0022url\u0022:\u0022http:\\\/\\\/anizone.to\\\/tag\\\/acttdztd\u0022,\u0022name\u0022:\u0022Swordplay\u0022}]}]'),
        nextCursor: 'eyJtYWluX3RpdGxlIjoiU3dvcmQgQXJ0IE9ubGluZTogQWxpY2l6YXRpb24gLSBXYXIgb2YgVW5kZXJ3b3JsZCAoMjAyMCkiLCJhbmltZS5zbHVnIjoiOTF5dGMzZzYiLCJfcG9pbnRzVG9OZXh0SXRlbXMiOnRydWV9',
        hasMore: true,
        loading: false,
        view: 'list',

        get activeGridItems() {
            return this.view === 'grid' ? this.items : [];
        },

        get activeListItems() {
            return this.view === 'list' ? this.items : [];
        },

        init() {
            const match = document.cookie.match(/(?:^|; )anime-view=([^;]*)/);
            if (match) {
                this.view = decodeURIComponent(match[1]);
            }
        },

        setView(newView) {
            this.view = newView;
            document.cookie = `anime-view=${newView}; path=/; max-age=31536000; SameSite=Lax`;
        },

        getTitle(anime) {
            return window.getTitle(anime.title_list, anime.main_title);
        },

        isBlurred(anime) {
            return anime.is_unsafe && (window.getUnsafeState?.().blur ?? false);
        },

        loadMore() {
            if (this.loading || !this.hasMore || !this.nextCursor) return;
            this.loading = true;
            $wire.loadPage(this.nextCursor);
        }
    }"
    @items-loaded.window="
        if ($event.detail.items && $event.detail.items.length) {
            items.push(...$event.detail.items);
        }
        nextCursor = $event.detail.nextCursor;
        hasMore = $event.detail.hasMore;
        loading = false;
    "
    @filters-reset.window="
        items.splice(0, items.length, ...$event.detail.items);
        nextCursor = $event.detail.nextCursor;
        hasMore = $event.detail.hasMore;
        loading = false;
    "
    class="w-full lg:container pb-[109px] md:pb-12 pt-12 px-4 space-y-12"
>
    <div class="space-y-4">
        <h1 class="text-xl xs:text-2xl md:text-3xl text-center lg:text-start text-slate-100">Anime Index</h1>

        <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between mb-4 gap-3">

    
    <div class="w-full lg:w-96 flex flex-col gap-1">
        <input
            wire:model.live.debounce.500="search"
            class="w-full rounded-lg bg-slate-900 border border-slate-700 placeholder:text-slate-200/50 focus:outline-none focus:ring-0 px-4 py-2.5"
            placeholder="Search Title"
        />
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </div>

    
    <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 sm:gap-4" role="group">

        
        <div class="grid grid-cols-2 sm:flex items-center gap-2 sm:gap-4 grow sm:grow-0">
            <!--[if BLOCK]><![endif]-->                <div class="w-full">
                    <select wire:model.live="type" class="w-full sm:w-auto rounded-lg bg-slate-900 border border-slate-700 focus:outline-none focus:ring-0 pl-4 pr-9 py-2.5">
<!--[if BLOCK]><![endif]-->    <option value="0">All</option>
    <option value="1">Unknown</option>
    <option value="2">TV Series</option>
    <option value="3">OVA</option>
    <option value="4">Movie</option>
    <option value="5">Other</option>
    <option value="6">Web</option>
    <option value="7">TV Special</option>
    <option value="8">Music Video</option>
<!--[if ENDBLOCK]><![endif]-->
</select>
                </div>
            <!--[if ENDBLOCK]><![endif]-->
            <!--[if BLOCK]><![endif]-->                <div class="w-full">
                    <select wire:model.live="sort" class="w-full sm:w-auto rounded-lg bg-slate-900 border border-slate-700 focus:outline-none focus:ring-0 pl-4 pr-9 py-2.5">
<!--[if BLOCK]><![endif]-->    <option value="title-asc">A-Z</option>
    <option value="title-desc">Z-A</option>
    <option value="release-asc">Earliest Release</option>
    <option value="release-desc">Latest Release</option>
    <option value="added-asc">First Added</option>
    <option value="added-desc">Last Added</option>
<!--[if ENDBLOCK]><![endif]-->
</select>
                </div>
            <!--[if ENDBLOCK]><![endif]-->        </div>

        
        <div wire:ignore class="flex items-center space-x-1 bg-slate-900 p-1 rounded-lg border border-slate-700 shrink-0 ml-auto lg:ml-0">
            <button 
                type="button"
                @click="setView('list')"
                :class="view === 'list' ? 'bg-slate-700 text-white' : 'text-slate-400 hover:text-slate-200'"
                class="p-2 rounded-md transition-colors"
                aria-label="List View"
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="w-5 h-5" fill="currentColor">
    <path d="M40 48C26.7 48 16 58.7 16 72v48c0 13.3 10.7 24 24 24H88c13.3 0 24-10.7 24-24V72c0-13.3-10.7-24-24-24H40zM192 64c-17.7 0-32 14.3-32 32s14.3 32 32 32H480c17.7 0 32-14.3 32-32s-14.3-32-32-32H192zm0 160c-17.7 0-32 14.3-32 32s14.3 32 32 32H480c17.7 0 32-14.3 32-32s-14.3-32-32-32H192zm0 160c-17.7 0-32 14.3-32 32s14.3 32 32 32H480c17.7 0 32-14.3 32-32s-14.3-32-32-32H192zM16 232v48c0 13.3 10.7 24 24 24H88c13.3 0 24-10.7 24-24V232c0-13.3-10.7-24-24-24H40c-13.3 0-24 10.7-24 24zM40 368c-13.3 0-24 10.7-24 24v48c0 13.3 10.7 24 24 24H88c13.3 0 24-10.7 24-24V392c0-13.3-10.7-24-24-24H40z"/>
</svg>            </button>

            <button 
                type="button"
                @click="setView('grid')"
                :class="view === 'grid' ? 'bg-slate-700 text-white' : 'text-slate-400 hover:text-slate-200'"
                class="p-2 rounded-md transition-colors"
                aria-label="Grid View"
            >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor">
    <path fill-rule="evenodd" d="M3 6a3 3 0 0 1 3-3h2.25a3 3 0 0 1 3 3v2.25a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6Zm9.75 0a3 3 0 0 1 3-3H18a3 3 0 0 1 3 3v2.25a3 3 0 0 1-3 3h-2.25a3 3 0 0 1-3-3V6ZM3 15.75a3 3 0 0 1 3-3h2.25a3 3 0 0 1 3 3V18a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-2.25Zm9.75 0a3 3 0 0 1 3-3H18a3 3 0 0 1 3 3V18a3 3 0 0 1-3 3h-2.25a3 3 0 0 1-3-3v-2.25Z" clip-rule="evenodd" />
</svg>
              </button>
        </div>

    </div>

</div>
        <div 
            x-show="window.getUnsafeState?.()?.blur"
            x-cloak
            class="max-w-xl flex justify-center mx-auto"
        >
            <div class="w-full text-white text-center bg-rose-600/90 p-4 py-3 border border-rose-500/90 rounded-md">
                Safesearch filter is active. You can disable it in the 
                <a href="https://anizone.to/settings" wire:navigate class="text-white font-bold underline">Settings</a> page.
            </div>
        </div>

        
        <div wire:ignore>
            
            <div x-show="view === 'grid'">
                <ul x-show="items.length > 0" class="grid grid-cols-2 xs:grid-cols-3 md:grid-cols-4 xl:grid-cols-6 gap-4 sm:gap-8 list-none">
                    <template x-for="anime in activeGridItems" :key="'grid-' + anime.slug">
                        <li 
    x-data="{ inView: false, loaded: false }"
    class="space-y-3 pb-6"
>
    
    <div class="relative block aspect-[5/7] overflow-hidden drop-shadow-lg rounded-lg bg-gray-700">
        <a
            wire:navigate
            :href="anime.url"
            x-intersect.margin.200px.once="inView = true"
            class="block w-full h-full"
        >
            <template x-if="inView">
                <img
                    :src="anime.cover"
                    :alt="getTitle(anime)"
                    @load="loaded = true"
                    :class="{ 
                        'blur-md': isBlurred(anime),
                        'opacity-0': !loaded,
                        'opacity-100': loaded 
                    }"
                    class="absolute object-cover h-full w-full transition-opacity duration-300 ease-in-out"
                />
            </template>
        </a>
    </div>

    
    <div class="space-y-3">
        <div class="line-clamp-2">
            <a
                wire:navigate
                :href="anime.url"
                :title="getTitle(anime)"
                class="text-white hocus:text-amber-300 focus:outline-none focus:ring-0 transition-colors duration-300 ease-in-out"
            >
                <span x-text="getTitle(anime)"></span>
            </a>
        </div>

        <div class="flex flex-row text-xs pb-6 text-center">
            <span class="inline-block not-first:before:mx-1 not-first:before:content-['•']" x-text="anime.type"></span>
            <span class="inline-block not-first:before:mx-1 not-first:before:content-['•']" x-text="anime.is_ongoing ? 'Ongoing' : 'Completed'"></span>
        </div>
    </div>
</li>                    </template>
                </ul>
            </div>

            
            <div x-show="view === 'list'">
                <ul x-show="items.length > 0" class="grid grid-cols-1 2xl:grid-cols-2 gap-4 list-none">
                    <template x-for="anime in activeListItems" :key="'list-' + anime.slug">
                        <li 
    x-data="{ inView: false, loaded: false }"
    class="relative overflow-hidden h-26 rounded-lg px-4 py-3 bg-slate-900 drop-shadow-lg"
>
    
    <template x-if="!isBlurred(anime)">
        <div 
            x-intersect.margin.200px.once="inView = true"
            class="absolute -inset-y-0 -right-0 w-80"
        >
            <template x-if="inView">
                <img
                    :src="anime.cover"
                    :alt="getTitle(anime)"
                    @load="loaded = true"
                    :class="loaded ? 'opacity-25' : 'opacity-0'"
                    class="absolute w-full h-full object-cover bg-slate-700 transition-opacity duration-300 ease-in-out"
                />
            </template>
            <div class="absolute right-0 w-full h-full bg-gradient-to-l from-transparent to-slate-900"></div>
        </div>
    </template>

    
    <div class="relative flex flex-col gap-2">
        <div class="h-6 inline truncate">
            <a
                wire:navigate
                :href="anime.url"
                :title="getTitle(anime)"
                class="text-white inline hocus:text-amber-300 transition-colors duration-300 ease-in-out focus:outline-none focus:ring-0"
            >
                <span x-text="getTitle(anime)"></span>
            </a>
        </div>

        <div class="inline text-xs h-4 line-clamp-1">
            <span class="not-last:after:mx-1 not-last:after:content-['•']" x-text="anime.type"></span>

            <template x-if="anime.start_year">
                <span class="not-last:after:mx-1 not-last:after:content-['•']" x-text="anime.start_year"></span>
            </template>

            <template x-if="anime.episode_count">
                <span class="not-last:after:mx-1 not-last:after:content-['•']" x-text="`${anime.episode_count} Eps`"></span>
            </template>

            <span class="not-last:after:mx-1 not-last:after:content-['•']" x-text="anime.is_ongoing ? 'Ongoing' : 'Completed'"></span>
        </div>

        <template x-if="anime.tags && anime.tags.length">
            <div class="flex flex-wrap gap-2 line-clamp-1 h-6">
                <template x-for="tag in anime.tags" :key="tag.slug">
                    <a
                        wire:navigate
                        :href="tag.url"
                        :title="tag.name"
                        x-text="tag.name"
                        class="px-2 py-1 rounded-full text-xs text-white bg-gray-600 hocus:bg-emerald-600 focus:outline-none transition-colors duration-300 ease-in-out"
                    ></a>
                </template>
            </div>
        </template>
    </div>
</li>                    </template>
                </ul>
            </div>
        </div>

        
        <div x-show="items.length === 0" x-cloak class="max-w-xl flex justify-center mx-auto">
            <div class="w-full text-center bg-sky-600 p-4 py-3 border border-sky-500 rounded-md">Nothing found.</div>
        </div>
    </div>

    <div x-show="loading" class="w-full">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="fill-current h-12 w-12 mx-auto animate-spin">
    <path d="M304 48a48 48 0 1 0 -96 0 48 48 0 1 0 96 0zm0 416a48 48 0 1 0 -96 0 48 48 0 1 0 96 0zM48 304a48 48 0 1 0 0-96 48 48 0 1 0 0 96zm464-48a48 48 0 1 0 -96 0 48 48 0 1 0 96 0zM142.9 437A48 48 0 1 0 75 369.1 48 48 0 1 0 142.9 437zm0-294.2A48 48 0 1 0 75 75a48 48 0 1 0 67.9 67.9zM369.1 437A48 48 0 1 0 437 369.1 48 48 0 1 0 369.1 437z"/>
</svg>    </div>

    <div
        x-show="hasMore && !loading"
        class="h-12"
        x-intersect="loadMore()"
    ></div>
</div>
        </div>
