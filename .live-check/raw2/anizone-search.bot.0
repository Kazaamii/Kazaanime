                    <div class="w-full flex justify-center select-none overflow-hidden" 
     x-data="{ 
        blocked: false,
        checkAd() {
            setTimeout(() => {
                const slot = this.$refs.slot;
                if (!slot) return;

                const hasNoChildren = slot.children.length === 0;
                let elementsHidden = false;

                if (!hasNoChildren) {
                    elementsHidden = Array.from(slot.children).every(child => {
                        const style = window.getComputedStyle(child);
                        return style.display === 'none' || 
                               style.visibility === 'hidden' || 
                               child.offsetHeight < 10;
                    });
                }

                if (hasNoChildren || elementsHidden) {
                    this.blocked = true;
                }
            }, 2500);
        }
     }" 
     x-init="checkAd()">
    
    <div class="relative max-w-[728px] min-h-[90px] w-full">
        <div x-show="blocked" 
            x-transition.opacity.duration.500ms
            x-cloak
            class="absolute inset-0 flex items-center justify-center bg-gray-700 text-center text-balance text-gray-500 font-semibold border-4 border-dashed border-gray-600 rounded-xl overflow-hidden">
            <p class="px-4 xs:text-lg sm:text-xl md:text-2xl">
                We don't use intrusive ads and hope you disable your adblock.
            </p>
        </div>

        <div x-ref="slot" class="w-full h-full flex justify-center">
            <div id="frame" style="width: 728px;margin: auto;z-index: 99998;height: auto">
          <iframe data-aa='2419912' src='//ad.a-ads.com/2419912/?size=728x90'
                            style='border:0; padding:0; width:728px; height:90px; overflow:hidden;display: block;margin: auto'></iframe>
        </div>
        </div>
    </div>
