    return m ? parseInt(m[1], 10) : null;
  }

  function olah(wadah) {
    var anak = [], n, i;
    for (i = 0; i < wadah.children.length; i++) {
      var el = wadah.children[i];
      var a  = (el.tagName === 'A') ? el : el.querySelector('a');
      if (!a) return;                                   /* ada anak yang bukan tautan → bukan daftar episode */
      n = nomor(a);
      if (n === null) return;
      anak.push({ el: el, n: n, kini: !!(a.getAttribute('aria-current') || /(^|\s)(aktif|active|current|on)(\s|$)/.test(a.className)) });
    }
    if (anak.length < AMBANG) return;

    var maks = 0;
    for (i = 0; i < anak.length; i++) if (anak[i].n > maks) maks = anak[i].n;
    if (maks <= PER) return;                            /* 1..100 saja: tak perlu dipecah */

    var grup = {}, urut = [];
    for (i = 0; i < anak.length; i++) {
      var g = Math.floor((anak[i].n - 1) / PER);
      if (!grup[g]) { grup[g] = []; urut.push(g); }
      grup[g].push(anak[i]);
      anak[i].g = g;
    }
    urut.sort(function (a, b) { return a - b; });

    /* grup yang ditampilkan lebih dulu = grup episode yang sedang dibuka; kalau tak ada,
       grup TERTINGGI (episode terbaru) — itu yang dicari pengunjung. */
    var awal = urut[urut.length - 1];
    for (i = 0; i < anak.length; i++) if (anak[i].kini) { awal = anak[i].g; break; }

    var bar = document.createElement('div'); bar.className = 'jer-bar';
    var sel = document.createElement('select');
    sel.setAttribute('aria-label', 'Pilih rentang episode');
    for (i = 0; i < urut.length; i++) {
      var g = urut[i], a1 = g * PER + 1, a2 = Math.min((g + 1) * PER, maks);
      var o = document.createElement('option');
      o.value = g;
      o.textContent = 'Episode ' + a1 + ' – ' + a2 + '  (' + grup[g].length + ')';
      if (g === awal) o.selected = true;
      sel.appendChild(o);
    }
    var cap = document.createElement('span');
    cap.className = 'jer-cap';
    cap.textContent = anak.length + ' episode';
    bar.appendChild(sel); bar.appendChild(cap);
    wadah.parentNode.insertBefore(bar, wadah);

    function tampil(g) {
      for (var j = 0; j < anak.length; j++) {
        anak[j].el.classList.toggle('jer-sembunyi', anak[j].g !== g);
      }
    }
    sel.addEventListener('change', function () { tampil(parseInt(sel.value, 10)); });
    tampil(awal);
    wadah.classList.add('jer-petak');   /* bentuk daftarnya ikut diringkas, bukan cuma jumlahnya */
  }

  function jalan() {
    /* kandidat: elemen yang punya banyak anak dan anak pertamanya tautan */
    var semua = document.querySelectorAll('div,ul,ol,nav,section,tbody');
    for (var i = 0; i < semua.length; i++) {
      var w = semua[i];
      if (w.children.length < AMBANG) continue;
      if (w.querySelector('.jer-bar')) continue;
      var k = (w.className || '') + ' ' + (w.id || '');
      if (/pagin|pager|page-nav|nav-links|menu|breadcrumb/i.test(k)) continue;
      try { olah(w); } catch (e) {}
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', jalan);
  else jalan();
})();
</script>
